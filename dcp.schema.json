{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
    "title": "DCP Plugin Configuration",
    "description": "Configuration schema for the OpenCode Dynamic Context Pruning plugin",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string",
            "description": "JSON Schema reference for IDE autocomplete"
        },
        "enabled": {
            "$ref": "#/$defs/enabledSetting"
        },
        "debug": {
            "$ref": "#/$defs/debugSetting"
        },
        "showUpdateToasts": {
            "$ref": "#/$defs/showUpdateToastsSetting"
        },
        "pruneNotification": {
            "$ref": "#/$defs/pruneNotificationSetting"
        },
        "turnProtection": {
            "$ref": "#/$defs/turnProtectionSetting"
        },
        "protectedFilePatterns": {
            "$ref": "#/$defs/protectedFilePatternsSetting"
        },
        "tools": {
            "$ref": "#/$defs/toolsSetting"
        },
        "strategies": {
            "$ref": "#/$defs/strategiesSetting"
        },
        "overrides": {
            "$ref": "#/$defs/overrides"
        }
    },
    "$defs": {
        "enabledSetting": {
            "type": "boolean",
            "default": true,
            "description": "Enable or disable the DCP plugin"
        },
        "debugSetting": {
            "type": "boolean",
            "default": false,
            "description": "Enable debug logging"
        },
        "showUpdateToastsSetting": {
            "type": "boolean",
            "default": true,
            "description": "(Deprecated) Show DCP update toasts"
        },
        "pruneNotificationSetting": {
            "type": "string",
            "enum": ["off", "minimal", "detailed"],
            "default": "detailed",
            "description": "Level of notification shown when pruning occurs"
        },
        "turnProtectionSetting": {
            "type": "object",
            "description": "Protect recent tool outputs from being pruned",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable turn-based protection"
                },
                "turns": {
                    "type": "number",
                    "default": 4,
                    "description": "Number of recent turns to protect from pruning"
                }
            }
        },
        "protectedFilePatternsSetting": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "default": [],
            "description": "Glob patterns for files that should be protected from pruning (e.g., '**/*.config.ts')"
        },
        "toolSettings": {
            "type": "object",
            "description": "General tool settings",
            "additionalProperties": false,
            "properties": {
                "nudgeEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable nudge reminders to prune context"
                },
                "nudgeFrequency": {
                    "type": "number",
                    "default": 10,
                    "description": "Frequency of nudge reminders (in turns)"
                },
                "protectedTools": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "task",
                        "todowrite",
                        "todoread",
                        "discard",
                        "extract",
                        "batch",
                        "write",
                        "edit"
                    ],
                    "description": "Tool names that should be protected from automatic pruning"
                }
            }
        },
        "discardToolSetting": {
            "type": "object",
            "description": "Configuration for the discard tool",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable the discard tool"
                }
            }
        },
        "extractToolSetting": {
            "type": "object",
            "description": "Configuration for the extract tool",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable the extract tool"
                },
                "showDistillation": {
                    "type": "boolean",
                    "default": false,
                    "description": "Show distillation output in the UI"
                }
            }
        },
        "toolsSetting": {
            "type": "object",
            "description": "Configuration for pruning tools",
            "additionalProperties": false,
            "properties": {
                "settings": {
                    "$ref": "#/$defs/toolSettings"
                },
                "discard": {
                    "$ref": "#/$defs/discardToolSetting"
                },
                "extract": {
                    "$ref": "#/$defs/extractToolSetting"
                }
            }
        },
        "deduplicationStrategy": {
            "type": "object",
            "description": "Remove duplicate tool outputs",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable deduplication strategy"
                },
                "protectedTools": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "task",
                        "todowrite",
                        "todoread",
                        "discard",
                        "extract",
                        "batch",
                        "write",
                        "edit"
                    ],
                    "description": "Tool names excluded from deduplication"
                }
            }
        },
        "supersedeWritesStrategy": {
            "type": "object",
            "description": "Replace older write/edit outputs when new ones target the same file",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable supersede writes strategy"
                }
            }
        },
        "purgeErrorsStrategy": {
            "type": "object",
            "description": "Remove tool outputs that resulted in errors",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable purge errors strategy"
                },
                "turns": {
                    "type": "number",
                    "default": 4,
                    "description": "Number of turns after which errors are purged"
                },
                "protectedTools": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "task",
                        "todowrite",
                        "todoread",
                        "discard",
                        "extract",
                        "batch",
                        "write",
                        "edit"
                    ],
                    "description": "Tool names excluded from error purging"
                }
            }
        },
        "strategiesSetting": {
            "type": "object",
            "description": "Automatic pruning strategies",
            "additionalProperties": false,
            "properties": {
                "deduplication": {
                    "$ref": "#/$defs/deduplicationStrategy"
                },
                "supersedeWrites": {
                    "$ref": "#/$defs/supersedeWritesStrategy"
                },
                "purgeErrors": {
                    "$ref": "#/$defs/purgeErrorsStrategy"
                }
            }
        },
        "baseConfig": {
            "type": "object",
            "properties": {
                "enabled": {
                    "$ref": "#/$defs/enabledSetting"
                },
                "debug": {
                    "$ref": "#/$defs/debugSetting"
                },
                "showUpdateToasts": {
                    "$ref": "#/$defs/showUpdateToastsSetting"
                },
                "pruneNotification": {
                    "$ref": "#/$defs/pruneNotificationSetting"
                },
                "turnProtection": {
                    "$ref": "#/$defs/turnProtectionSetting"
                },
                "protectedFilePatterns": {
                    "$ref": "#/$defs/protectedFilePatternsSetting"
                },
                "tools": {
                    "$ref": "#/$defs/toolsSetting"
                },
                "strategies": {
                    "$ref": "#/$defs/strategiesSetting"
                }
            }
        },
        "modelOverrideConfig": {
            "$ref": "#/$defs/baseConfig"
        },
        "overrideConfig": {
            "allOf": [
                { "$ref": "#/$defs/baseConfig" },
                {
                    "type": "object",
                    "properties": {
                        "models": {
                            "type": "object",
                            "description": "Model-specific overrides. Keys can use glob patterns (* and ?) to match model IDs.",
                            "additionalProperties": {
                                "$ref": "#/$defs/modelOverrideConfig"
                            }
                        }
                    }
                }
            ]
        },
        "overrides": {
            "type": "object",
            "description": "Per-provider and per-model configuration overrides",
            "additionalProperties": false,
            "properties": {
                "provider": {
                    "type": "object",
                    "description": "Provider-specific overrides (e.g., 'anthropic', 'openai')",
                    "additionalProperties": {
                        "$ref": "#/$defs/overrideConfig"
                    }
                }
            }
        }
    }
}
